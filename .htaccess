# Standart (Apache / cPanel) hosting için: temiz adresler, doğru MIME, sıkıştırma, önbellek
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddType text/javascript .js .mjs
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
<IfModule mod_rewrite.c>
RewriteEngine On
# HTTPS'e yönlendir (SSL açıkken aktif edin)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# /klasor -> /klasor/
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 week"
ExpiresByType text/javascript "access plus 1 week"
</IfModule>
